<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ArmyGeneratorMaui.MainPage"
             xmlns:viewModel="clr-namespace:ArmyGeneratorMaui.ViewModels"
             x:DataType="viewModel:UnitsViewModel"
             Title="Army Generator">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="12">
            <Label Text="Imported armies" FontSize="24" FontAttributes="Bold" />

            <Button Text="Import JSON army" Command="{Binding ImportArmyCommand}" />

            <CollectionView ItemsSource="{Binding ImportedArmies}"
                           SelectedItem="{Binding SelectedArmy, Mode=TwoWay}"
                           SelectionMode="Single"
                           HeightRequest="150">
                <CollectionView.ItemTemplate>
                   <DataTemplate x:DataType="viewModel:ImportedArmyViewModel">
                       <Label Text="{Binding DisplayName}" Padding="10" />
                   </DataTemplate>
               </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Unit quantity limits" FontSize="20" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding UnitLimits}"
                           SelectionMode="None"
                           HeightRequest="300">
               <CollectionView.ItemTemplate>
                   <DataTemplate x:DataType="viewModel:UnitQuantityViewModel">
                       <Grid Padding="6" ColumnSpacing="10">
                           <Grid.ColumnDefinitions>
                               <ColumnDefinition Width="*" />
                               <ColumnDefinition Width="Auto" />
                               <ColumnDefinition Width="40" />
                               <ColumnDefinition Width="Auto" />
                           </Grid.ColumnDefinitions>
                           <Label Text="{Binding Name}" VerticalTextAlignment="Center" />
                           <Button Grid.Column="1" Text="−" Command="{Binding DecreaseQuantityCommand}" />
                           <Label Grid.Column="2" Text="{Binding MaxQuantity}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                           <Button Grid.Column="3" Text="+" Command="{Binding IncreaseQuantityCommand}" />
                       </Grid>
                   </DataTemplate>
               </CollectionView.ItemTemplate>
            </CollectionView>

            <Entry Placeholder="Maximum points"
                  Keyboard="Numeric"
                  Text="{Binding MaxSizeOfRoster}" />
            <Button Text="Generate rosters" Command="{Binding GenerateRostersCommand}" />
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
               <ActivityIndicator IsRunning="{Binding IsGenerating}"
                                 IsVisible="{Binding IsGenerating}" />
               <Label Text="{Binding GenerationProgress}" VerticalTextAlignment="Center" />
            </HorizontalStackLayout>

            <Label Text="Generated rosters (tap to copy)" FontSize="20" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding GeneratedRosters}"
                           SelectionMode="None"
                           HeightRequest="350">
               <CollectionView.ItemTemplate>
                   <DataTemplate x:DataType="viewModel:GeneratedRosterViewModel">
                       <Button Text="{Binding Title}"
                               Clicked="OnRosterTapped"
                               HorizontalOptions="Fill" />
                   </DataTemplate>
               </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
