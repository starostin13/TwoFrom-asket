<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ArmyGeneratorMaui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ArmyGeneratorMaui"
    xmlns:views="clr-namespace:ArmyGeneratorMaui.Views"
    Shell.FlyoutBehavior="Disabled">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Roster Selection"
        ContentTemplate="{DataTemplate views:RosterSelectionView}"
        Route="roster-selection" />

</Shell>
