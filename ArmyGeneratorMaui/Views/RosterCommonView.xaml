<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ArmyGeneratorMaui.Views.RosterCommonView">
    <VerticalStackLayout Spacing="10">
        <Label Text="Saved Rosters" FontSize="16" FontAttributes="Bold"/>
        
        <CollectionView ItemsSource="{Binding SavedRosters}" 
                        SelectionMode="Single"
                        SelectedItemChangedCommand="{Binding RosterSelectedCommand}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout Padding="10" Spacing="5" BackgroundColor="#F5F5F5">
                        <Label Text="{Binding DisplayName}" FontSize="14" FontAttributes="Bold"/>
                        <Label Text="{Binding DisplayInfo}" FontSize="12" TextColor="#666666"/>
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Text="Current Roster" FontSize="16" FontAttributes="Bold" Margin="0,10,0,0"/>
        
        <ListView ItemsSource="{Binding Units}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Grid Padding="10">
                            <Grid.RowDefinitions>
                               <RowDefinition Height="Auto" />
                               <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                               <ColumnDefinition Width="Auto" />
                               <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Grid.RowSpan="2"
                               Text="{Binding Price}"
                               FontAttributes="Bold" 
                               VerticalTextAlignment="Center"/>
                            <Label Grid.Column="1"
                               Text="{Binding Name}"
                               FontAttributes="Bold" />
                            <Label Grid.Row="1"
                               Grid.Column="1"
                               Text="{Binding Enchasment}"
                               FontAttributes="Italic"
                               VerticalOptions="End" />
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </VerticalStackLayout>
</ContentView>
